{% extends "./layout.njk" %}

{% block navStart %}
        <a href="/" class="text-slate-300 hover:text-white transition-colors" aria-label="Back to home">
          <i class="bx bx-arrow-back text-xl"></i>
        </a>
{% endblock %}

{% block content %}
    {% set baseUrl = dPlusBaseUrl if dPlusMode else (publishingBaseUrl if publishingMode else (opsBaseUrl if opsMode else "/" + org)) %}

    {% if dPlusMode %}
    <div class="bg-purple-600 dark:bg-purple-700 border-b-2 border-purple-800 dark:border-purple-900 px-4 py-2 text-white font-semibold text-sm flex items-center gap-3">
      <i class="bx bx-info-circle text-base"></i>
      <span>This dashboard shows only repos marked D+, delivery-plus, or internal.</span>
    </div>
    {% elif publishingMode %}
    <div class="bg-orange-600 dark:bg-orange-700 border-b-2 border-orange-800 dark:border-orange-900 px-4 py-2 text-white font-semibold text-sm flex items-center gap-3">
      <i class="bx bx-info-circle text-base"></i>
      <span>This dashboard shows only repos marked Publishing.</span>
    </div>
    {% elif opsMode %}
    <div class="bg-cyan-600 dark:bg-cyan-700 border-b-2 border-cyan-800 dark:border-cyan-900 px-4 py-2 text-white font-semibold text-sm flex items-center gap-3">
      <i class="bx bx-info-circle text-base"></i>
      <span>This dashboard shows only repos marked dalmatian or tech-ops.</span>
    </div>
    {% endif %}

    <div class="container mx-auto flex flex-col mt-3 space-y-3">
      <div class="bg-slate-100 dark:bg-slate-900 rounded-lg border-b-4 border-slate-300 dark:border-slate-950 space-y-2">
        <h2 class="bg-slate-50 dark:bg-slate-800 rounded-t-lg border-b-2 border-slate-200 dark:border-slate-900 text-base font-bold px-4 py-2 flex items-center gap-3">
          <span>{{ org }}</span>
          <span class="text-xs font-medium text-slate-500 dark:text-slate-400">{{ totalRepos }} repos tracked</span>
          <span class="text-xs font-medium text-red-600 dark:text-red-400">Critical: {{ totalCriticalVulnerabilities }}</span>
          <span class="text-xs font-medium text-yellow-600 dark:text-yellow-400">Total: {{ totalVulnerabilities }}</span>
          {% if dPlusMode or publishingMode or opsMode %}<span class="text-xs font-medium text-blue-600 dark:text-blue-400">Open bot PRs: {{ totalOpenBotPrs }}</span>{% endif %}
        </h2>

        <!-- Controls box: filters, sorts, save, saved configurations -->
        <div class="mx-4 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 divide-y divide-slate-200 dark:divide-slate-700">

          <!-- Alert filters + sort + save row -->
          <div class="p-2 flex flex-wrap items-center gap-2" data-testid="filter-row">
            <!-- Critical alerts filter (toggles off when already active) -->
            {% if alertFilter === 'criticalOnly' %}
              {% set criticalParams = baseUrl %}
              {% set criticalSep = "?" %}
              {% if sortBy %}{% set criticalParams = criticalParams + criticalSep + "sortBy=" + sortBy %}{% set criticalSep = "&" %}{% endif %}
              {% if sortDirection %}{% set criticalParams = criticalParams + criticalSep + "sortDirection=" + sortDirection %}{% set criticalSep = "&" %}{% endif %}
              {% if tag %}{% set criticalParams = criticalParams + criticalSep + "tag=" + tag %}{% endif %}
            {% else %}
              {% set criticalParams = baseUrl + "?alertFilter=criticalOnly" %}
              {% if sortBy %}{% set criticalParams = criticalParams + "&sortBy=" + sortBy %}{% endif %}
              {% if sortDirection %}{% set criticalParams = criticalParams + "&sortDirection=" + sortDirection %}{% endif %}
              {% if tag %}{% set criticalParams = criticalParams + "&tag=" + tag %}{% endif %}
            {% endif %}
            <a href="{{ criticalParams }}" class="inline-flex items-center rounded-full border px-3 py-1 text-sm font-medium transition-colors {% if alertFilter === 'criticalOnly' %}bg-red-700 text-white border-red-700 dark:bg-red-600 dark:border-red-600{% else %}bg-slate-200 text-slate-700 border-slate-400 hover:bg-slate-300 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-600 dark:hover:bg-slate-700{% endif %}">
              Critical only
            </a>

            <!-- Any alerts filter (toggles off when already active) -->
            {% if alertFilter === 'anyAlerts' %}
              {% set anyAlertsParams = baseUrl %}
              {% set anyAlertsSep = "?" %}
              {% if sortBy %}{% set anyAlertsParams = anyAlertsParams + anyAlertsSep + "sortBy=" + sortBy %}{% set anyAlertsSep = "&" %}{% endif %}
              {% if sortDirection %}{% set anyAlertsParams = anyAlertsParams + anyAlertsSep + "sortDirection=" + sortDirection %}{% set anyAlertsSep = "&" %}{% endif %}
              {% if tag %}{% set anyAlertsParams = anyAlertsParams + anyAlertsSep + "tag=" + tag %}{% endif %}
            {% else %}
              {% set anyAlertsParams = baseUrl + "?alertFilter=anyAlerts" %}
              {% if sortBy %}{% set anyAlertsParams = anyAlertsParams + "&sortBy=" + sortBy %}{% endif %}
              {% if sortDirection %}{% set anyAlertsParams = anyAlertsParams + "&sortDirection=" + sortDirection %}{% endif %}
              {% if tag %}{% set anyAlertsParams = anyAlertsParams + "&tag=" + tag %}{% endif %}
            {% endif %}
            <a href="{{ anyAlertsParams }}" class="inline-flex items-center rounded-full border px-3 py-1 text-sm font-medium transition-colors {% if alertFilter === 'anyAlerts' %}bg-yellow-600 text-white border-yellow-600 dark:bg-yellow-500 dark:border-yellow-500{% else %}bg-slate-200 text-slate-700 border-slate-400 hover:bg-slate-300 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-600 dark:hover:bg-slate-700{% endif %}">
              Any alerts
            </a>

            <!-- Mode filters (toggle off when already active) -->
            {% set modeFilters = [
              { name: "Only D+", path: "d-plus", active: dPlusMode },
              { name: "Only Publishing", path: "publishing", active: publishingMode },
              { name: "Only Ops", path: "ops", active: opsMode }
            ] %}
            {% for mode in modeFilters %}
            <a href="/{{ org }}{% if not mode.active %}/{{ mode.path }}{% endif %}" class="inline-flex items-center rounded-full border px-3 py-1 text-sm font-medium transition-colors {% if mode.active %}bg-slate-700 text-white border-slate-700 dark:bg-slate-200 dark:text-slate-900 dark:border-slate-200{% else %}bg-slate-200 text-slate-700 border-slate-400 hover:bg-slate-300 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-600 dark:hover:bg-slate-700{% endif %}">
              {{ mode.name }}
            </a>
            {% endfor %}

            <!-- No tags filter (toggles off when already active) -->
            {% set untaggedActive = untaggedTag in selectedTags %}
            {% set untaggedTags = (selectedTags | reject("equalto", untaggedTag) | join(",")) if untaggedActive else untaggedTag %}
            {% set untaggedParams = "/" + org %}
            {% set untaggedSep = "?" %}
            {% if untaggedTags %}{% set untaggedParams = untaggedParams + untaggedSep + "tag=" + untaggedTags %}{% set untaggedSep = "&" %}{% endif %}
            {% if alertFilter %}{% set untaggedParams = untaggedParams + untaggedSep + "alertFilter=" + alertFilter %}{% set untaggedSep = "&" %}{% endif %}
            {% if sortBy %}{% set untaggedParams = untaggedParams + untaggedSep + "sortBy=" + sortBy %}{% set untaggedSep = "&" %}{% endif %}
            {% if sortDirection %}{% set untaggedParams = untaggedParams + untaggedSep + "sortDirection=" + sortDirection %}{% endif %}
            <a href="{{ untaggedParams }}" data-testid="untagged-filter" class="inline-flex items-center rounded-full border px-3 py-1 text-sm font-medium transition-colors {% if untaggedActive %}bg-slate-700 text-white border-slate-700 dark:bg-slate-200 dark:text-slate-900 dark:border-slate-200{% else %}bg-slate-200 text-slate-700 border-slate-400 hover:bg-slate-300 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-600 dark:hover:bg-slate-700{% endif %}">
              No tags
            </a>

            <!-- Sort dropdown -->
            <div class="flex items-center gap-1" data-testid="sort-controls">
              <label for="sort-select" class="text-xs text-slate-500 dark:text-slate-400 font-medium">Sort:</label>
              <select id="sort-select" class="rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 text-sm px-2 py-1 focus:outline-none focus:ring-2 focus:ring-slate-400 dark:focus:ring-slate-500 cursor-pointer"
                onchange="window.location.href=this.value">
                {% set defaultParams = baseUrl %}
                {% set defaultSep = "?" %}
                {% if alertFilter %}{% set defaultParams = defaultParams + defaultSep + "alertFilter=" + alertFilter %}{% set defaultSep = "&" %}{% endif %}
                {% if tag %}{% set defaultParams = defaultParams + defaultSep + "tag=" + tag %}{% endif %}
                <option value="{{ defaultParams }}" {% if not sortBy %}selected{% endif %}>Default</option>
                {% set sortOptions = [
                  { name: "Critical alerts", id: "criticalSeverityAlerts" },
                  { name: "Total alerts", id: "totalOpenAlerts" },
                  { name: "Open issues", id: "openIssues" },
                  { name: "Open bot PRs", id: "openBotPrCount" },
                  { name: "Open PRs", id: "openPrCount" },
                  { name: "Updated at", id: "updatedAt" },
                  { name: "Most recent PR", id: "mostRecentPrOpenedAt" },
                  { name: "Oldest open PR", id: "oldestOpenPrOpenedAt" },
                  { name: "Last bot PR closed", id: "mostRecentBotPrClosedAt" },
                  { name: "Most recent issue", id: "mostRecentIssueOpenedAt" },
                  { name: "Oldest open issue", id: "oldestOpenIssueOpenedAt" }
                ] %}
                {% for opt in sortOptions %}
                  {% set optParams = baseUrl + "?sortBy=" + opt.id + "&sortDirection=asc" %}
                  {% if alertFilter %}{% set optParams = optParams + "&alertFilter=" + alertFilter %}{% endif %}
                  {% if tag %}{% set optParams = optParams + "&tag=" + tag %}{% endif %}
                  <option value="{{ optParams }}" {% if sortBy === opt.id and sortDirection === "asc" %}selected{% endif %}>{{ opt.name }} ↓</option>
                  {% set optParamsDesc = baseUrl + "?sortBy=" + opt.id + "&sortDirection=desc" %}
                  {% if alertFilter %}{% set optParamsDesc = optParamsDesc + "&alertFilter=" + alertFilter %}{% endif %}
                  {% if tag %}{% set optParamsDesc = optParamsDesc + "&tag=" + tag %}{% endif %}
                  <option value="{{ optParamsDesc }}" {% if sortBy === opt.id and sortDirection === "desc" %}selected{% endif %}>{{ opt.name }} ↑</option>
                {% endfor %}
              </select>
            </div>

            <!-- Save new config -->
            <details class="group/save relative ml-auto">
              <summary class="list-none cursor-pointer [&::-webkit-details-marker]:hidden inline-flex items-center gap-1 rounded-full border px-2.5 py-0.5 text-xs font-medium transition-colors bg-slate-200 text-slate-700 border-slate-400 hover:bg-slate-300 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-600 dark:hover:bg-slate-700">
                <i class="bx bx-bookmark-plus text-sm"></i>
                Save configuration
              </summary>
              <div class="absolute right-0 z-10 mt-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg shadow-lg p-3">
                <form method="POST" action="/{{ org }}/saved-configurations" class="flex items-center gap-2">
                  <input type="hidden" name="sortBy" value="{{ sortBy }}" />
                  <input type="hidden" name="sortDirection" value="{{ sortDirection }}" />
                  <input type="hidden" name="tag" value="{{ tag }}" />
                  <input type="hidden" name="alertFilter" value="{{ alertFilter }}" />
                  <input type="text" name="name" placeholder="Name (optional)"
                    class="rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-slate-400 w-44"
                  />
                  <button type="submit" class="inline-flex items-center gap-1 rounded-full border px-2.5 py-1 text-xs font-medium transition-colors bg-slate-700 text-white border-slate-700 hover:bg-slate-600 dark:bg-slate-200 dark:text-slate-900 dark:border-slate-200 dark:hover:bg-slate-300">
                    <i class="bx bx-save"></i>
                    Save
                  </button>
                </form>
              </div>
            </details>
          </div>


          <!-- Saved configurations row -->
          {% if savedConfigurations and savedConfigurations.length %}
          <div class="p-2 flex flex-wrap items-center gap-2">
            {% for config in savedConfigurations %}
            <div class="flex items-center">
              <a href="{{ config.applyUrl | safe }}" class="inline-flex items-center gap-1 rounded-l-full border px-2.5 py-0.5 text-xs font-medium transition-colors {% if config.id === activeConfigId %}bg-slate-700 text-white border-slate-700 dark:bg-slate-200 dark:text-slate-900 dark:border-slate-200{% else %}bg-slate-200 text-slate-700 border-slate-400 hover:bg-slate-300 dark:bg-slate-700 dark:text-slate-200 dark:border-slate-600 dark:hover:bg-slate-600{% endif %}">
                <i class="bx bx-bookmark text-xs"></i>
                {{ config.name }}
              </a>
              <form method="POST" action="/{{ org }}/saved-configurations/{{ config.id }}/delete" class="inline">
                <input type="hidden" name="sortBy" value="{{ sortBy }}" />
                <input type="hidden" name="sortDirection" value="{{ sortDirection }}" />
                <input type="hidden" name="tag" value="{{ tag }}" />
                <input type="hidden" name="alertFilter" value="{{ alertFilter }}" />
                <button type="submit" title="Delete" class="inline-flex items-center rounded-r-full border-t border-r border-b px-1.5 py-0.5 text-xs transition-colors bg-slate-200 text-slate-400 border-slate-400 hover:bg-red-100 hover:text-red-600 hover:border-red-400 dark:bg-slate-700 dark:text-slate-500 dark:border-slate-600 dark:hover:bg-red-950 dark:hover:text-red-400 dark:hover:border-red-800">
                  <i class="bx bx-x text-sm"></i>
                </button>
              </form>
            </div>
            {% endfor %}

            {% if activeConfigId %}
            <a href="{{ baseUrl }}" class="inline-flex items-center gap-1 rounded-full border px-2.5 py-0.5 text-xs font-medium transition-colors bg-slate-200 text-slate-700 border-slate-400 hover:bg-slate-300 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-600 dark:hover:bg-slate-700">
              <i class="bx bx-reset text-xs"></i>
              Clear
            </a>
            {% endif %}
          </div>
          {% endif %}


        </div>

        <!-- Repo table -->
        <div id="repo-table" class="mx-4 mb-4">
          <div id="repo-grid" class="w-full" style="height: 75vh" data-testid="repo-grid"
            data-tag-links="{{ 'false' if (dPlusMode or publishingMode or opsMode) else 'true' }}"
            data-selected-tags="{{ tag }}"></div>
          <script type="application/json" id="repo-grid-data">{{ gridRows | safe }}</script>
        </div>

      </div>
    </div>
{% endblock %}

{% block scripts %}
    <script src="https://cdn.jsdelivr.net/npm/ag-grid-community@36.2.0/dist/ag-grid-community.min.js"
      integrity="sha384-icvtRKM0YJJgeDhXnWY8UlF1PVBFd4K8Pj61la+vG+EU+awBeoP0xGPZhCD2SQOV"
      crossorigin="anonymous"></script>
    <script>
      (() => {
        const DASH = '\u2014';
        const gridElement = document.getElementById('repo-grid');
        const rowData = JSON.parse(document.getElementById('repo-grid-data').textContent);
        const tagLinksEnabled = gridElement.dataset.tagLinks === 'true';
        const selectedTags = (gridElement.dataset.selectedTags || '').split(',').filter(Boolean);

        // Clicking a tag toggles it in the server-side `tag` filter
        const tagFilterUrl = (tag) => {
          const tags = selectedTags.includes(tag)
            ? selectedTags.filter((selectedTag) => selectedTag !== tag)
            : [...selectedTags, tag];
          const url = new URL(window.location.href);
          if (tags.length) {
            url.searchParams.set('tag', tags.join(','));
          } else {
            url.searchParams.delete('tag');
          }
          return url.toString();
        };

        const compareDateToFilter = (filterDate, cellValue) => {
          if (!cellValue) return -1;
          const date = new Date(cellValue);
          const cellDay = new Date(date.getFullYear(), date.getMonth(), date.getDate());
          if (cellDay < filterDate) return -1;
          if (cellDay > filterDate) return 1;
          return 0;
        };

        // Dates are sorted/filtered on their ISO value but displayed in the user's chosen format.
        const dateColumn = (field, headerName) => ({
          colId: field,
          headerName,
          cellDataType: false,
          valueGetter: (params) => params.data[field].iso,
          valueFormatter: (params) => params.data[field].display ?? DASH,
          filter: 'agDateColumnFilter',
          filterParams: { comparator: compareDateToFilter },
          width: 130,
        });

        const numberColumn = (field, headerName, extra = {}) => ({
          field,
          headerName,
          cellDataType: 'number',
          type: 'rightAligned',
          filter: 'agNumberColumnFilter',
          valueFormatter: (params) => params.value ?? DASH,
          width: 105,
          ...extra,
        });

        const severityColumn = (field, headerName, color) =>
          numberColumn(field, headerName, {
            cellStyle: (params) => (params.value > 0 ? { color, fontWeight: '700' } : null),
          });

        const vulnerabilityGroup = (prefix, headerName) => ({
          headerName,
          marryChildren: true,
          children: [
            severityColumn(`${prefix}Critical`, 'Critical', '#dc2626'),
            severityColumn(`${prefix}High`, 'High', '#ef4444'),
            severityColumn(`${prefix}Medium`, 'Medium', '#f97316'),
            severityColumn(`${prefix}Low`, 'Low', '#f59e0b'),
            numberColumn(`${prefix}Total`, 'Total', { cellStyle: { fontWeight: '600' } }),
          ],
        });

        const repoLinkRenderer = (params) => {
          const link = document.createElement('a');
          link.href = params.data.htmlUrl;
          link.target = '_blank';
          link.rel = 'noopener';
          link.textContent = params.value;
          link.className = 'font-semibold hover:underline';
          return link;
        };

        const tagsRenderer = (params) => {
          const container = document.createElement('div');
          container.className = 'flex gap-1 items-center h-full overflow-hidden';
          for (const tag of params.data.tags) {
            const isSelected = selectedTags.includes(tag);
            const chip = document.createElement(tagLinksEnabled ? 'a' : 'span');
            if (tagLinksEnabled) chip.href = tagFilterUrl(tag);
            chip.className = 'text-xs rounded-full px-2 leading-5 transition-colors ' + (isSelected
              ? 'text-white bg-slate-700 dark:text-slate-900 dark:bg-slate-200'
              : 'bg-slate-200 text-slate-700 dark:bg-slate-900 dark:text-slate-300' + (tagLinksEnabled ? ' hover:bg-slate-300 dark:hover:bg-slate-800' : ''));
            chip.textContent = tag;
            container.appendChild(chip);
          }
          return container;
        };

        const describeEndOfLife = (dependency) => {
          const label = dependency.version ? `${dependency.name} v${dependency.version}` : dependency.name;
          const support = dependency.status === 'ended' ? 'support ended' : 'support ends';
          return dependency.relative ? `${label}: ${support} ${dependency.relative}` : `${label}: ${support}`;
        };

        // Ranks repos by how many dependencies are out of support, then by how many are ending soon
        const endOfLifeScore = (dependencies) => dependencies.reduce(
          (score, dependency) => score + (dependency.status === 'ended' ? 1000 : 1),
          0,
        );

        const endOfLifeRenderer = (params) => {
          const container = document.createElement('div');
          container.className = 'flex gap-1 items-center h-full overflow-hidden';
          for (const dependency of params.data.endOfLifeDependencies) {
            const chip = document.createElement('span');
            chip.className = 'font-mono text-xs rounded-full px-2 leading-5 whitespace-nowrap text-white ' +
              (dependency.status === 'ended' ? 'bg-red-600 dark:bg-red-500' : 'bg-amber-500 dark:bg-amber-600');
            chip.textContent = dependency.version ? `${dependency.name} v${dependency.version}` : dependency.name;
            chip.title = describeEndOfLife(dependency);
            container.appendChild(chip);
          }
          if (!params.data.endOfLifeDependencies.length) container.textContent = DASH;
          return container;
        };

        const columnDefs = [
          { field: 'name', headerName: 'Repo', pinned: 'left', width: 220, cellRenderer: repoLinkRenderer },
          { field: 'language', headerName: 'Language', width: 120, valueFormatter: (params) => params.value ?? DASH },
          numberColumn('openPrCount', 'Open PRs'),
          numberColumn('openBotPrCount', 'Open bot PRs'),
          dateColumn('oldestOpenPrOpenedAt', 'Oldest open PR'),
          dateColumn('updatedAt', 'Updated at'),
          dateColumn('mostRecentPrOpenedAt', 'Most recent PR'),
          dateColumn('mostRecentIssueOpenedAt', 'Most recent issue'),
          dateColumn('oldestOpenIssueOpenedAt', 'Oldest open issue'),
          numberColumn('openIssues', 'Open issues'),
          vulnerabilityGroup('prod', 'Prod vulnerabilities'),
          vulnerabilityGroup('dev', 'Dev vulnerabilities'),
          {
            colId: 'endOfLifeDependencies',
            headerName: 'End of life',
            headerTooltip: 'Dependencies that are out of support or whose support ends within a year',
            width: 260,
            cellDataType: false,
            valueGetter: (params) => params.data.endOfLifeDependencies.map(describeEndOfLife).join('; '),
            tooltipValueGetter: (params) => params.value || null,
            comparator: (valueA, valueB, nodeA, nodeB) =>
              endOfLifeScore(nodeA.data.endOfLifeDependencies) - endOfLifeScore(nodeB.data.endOfLifeDependencies),
            cellRenderer: endOfLifeRenderer,
          },
          {
            colId: 'tags',
            headerName: 'Tags',
            width: 260,
            valueGetter: (params) => params.data.tags.join(', '),
            tooltipValueGetter: (params) => params.value || null,
            cellRenderer: tagsRenderer,
          },
          { field: 'responsibleTeam', headerName: 'Responsible team', width: 150, valueFormatter: (params) => params.value ?? DASH },
          {
            colId: 'hasProdAlertOlderThan14Days',
            headerName: 'Prod vulnerability > 14 days old',
            headerTooltip: 'Has an open production vulnerability more than 14 days old',
            width: 150,
            cellDataType: false,
            valueGetter: (params) => {
              const value = params.data.hasProdAlertOlderThan14Days;
              if (value === null) return null;
              return value ? 'Yes' : 'No';
            },
            valueFormatter: (params) => params.value ?? DASH,
            cellStyle: (params) => (params.value === 'Yes' ? { color: '#dc2626', fontWeight: '700' } : null),
          },
        ];

        const theme = agGrid.themeQuartz
          .withParams({ fontFamily: 'inherit', fontSize: 13, headerFontWeight: 600, wrapperBorderRadius: 8 })
          .withParams({ accentColor: '#475569', browserColorScheme: 'light' }, 'light')
          .withParams({
            backgroundColor: '#1e293b',
            foregroundColor: '#e2e8f0',
            headerBackgroundColor: '#0f172a',
            borderColor: '#334155',
            accentColor: '#94a3b8',
            browserColorScheme: 'dark',
          }, 'dark');

        agGrid.createGrid(gridElement, {
          theme,
          rowData,
          columnDefs,
          defaultColDef: { sortable: true, filter: true, resizable: true, wrapHeaderText: true, autoHeaderHeight: true },
          pagination: true,
          paginationPageSize: 50,
          paginationPageSizeSelector: [25, 50, 100],
          suppressColumnVirtualisation: true,
          overlayNoRowsTemplate: '<span class="italic text-slate-400">No repositories found.</span>',
        });
      })();
    </script>
{% endblock %}
