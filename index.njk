{% extends "./layout.njk" %}

{% block navStart %}
        <a href="/" class="text-slate-300 hover:text-white transition-colors" aria-label="Back to home">
          <i class="bx bx-arrow-back text-xl"></i>
        </a>
{% endblock %}

{% block content %}
    {% set toggleClasses = "inline-flex items-center rounded-full border px-3 py-1 text-sm font-medium transition-colors bg-slate-200 text-slate-700 border-slate-400 hover:bg-slate-300 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-600 dark:hover:bg-slate-700" %}
    {% set slatePressedClasses = "aria-pressed:bg-slate-700 aria-pressed:text-white aria-pressed:border-slate-700 dark:aria-pressed:bg-slate-200 dark:aria-pressed:text-slate-900 dark:aria-pressed:border-slate-200" %}
    {% set filterButtons = [
      { label: "Runtime critical only", attribute: "data-alert-filter", value: "criticalOnly", pressedClasses: "aria-pressed:bg-red-700 aria-pressed:text-white aria-pressed:border-red-700 dark:aria-pressed:bg-red-600 dark:aria-pressed:border-red-600" },
      { label: "Any runtime alerts", attribute: "data-alert-filter", value: "anyAlerts", pressedClasses: "aria-pressed:bg-yellow-600 aria-pressed:text-white aria-pressed:border-yellow-600 dark:aria-pressed:bg-yellow-500 dark:aria-pressed:border-yellow-500" },
      { label: "Only D+", attribute: "data-mode", value: "d-plus", pressedClasses: slatePressedClasses },
      { label: "Only Publishing", attribute: "data-mode", value: "publishing", pressedClasses: slatePressedClasses },
      { label: "Only Ops", attribute: "data-mode", value: "ops", pressedClasses: slatePressedClasses },
      { label: "No tags", attribute: "data-tag", value: "_untagged", pressedClasses: slatePressedClasses }
    ] %}

    <div class="container mx-auto flex flex-col mt-3 space-y-3">
      <div class="bg-slate-100 dark:bg-slate-900 rounded-lg border-b-4 border-slate-300 dark:border-slate-950 space-y-2">
        <h2 class="bg-slate-50 dark:bg-slate-800 rounded-t-lg border-b-2 border-slate-200 dark:border-slate-900 text-base font-bold px-4 py-2 flex items-center gap-3">
          <span>{{ org }}</span>
          <span class="text-xs font-medium text-slate-500 dark:text-slate-400">{{ totalRepos }} repos tracked</span>
          <span class="text-xs font-medium text-red-600 dark:text-red-400">Critical: {{ totalCriticalVulnerabilities }}</span>
          <span class="text-xs font-medium text-yellow-600 dark:text-yellow-400">Total: {{ totalVulnerabilities }}</span>
        </h2>

        <!-- Controls box: filters, save, saved configurations -->
        <div class="mx-4 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 divide-y divide-slate-200 dark:divide-slate-700">

          <!-- Filter toggles + save row. The grid script keeps aria-pressed in sync with its filters. -->
          <div class="p-2 flex flex-wrap items-center gap-2" data-testid="filter-row">
            {% for button in filterButtons %}
            <button type="button" {{ button.attribute }}="{{ button.value }}" aria-pressed="false" class="{{ toggleClasses }} {{ button.pressedClasses }}">
              {{ button.label }}
            </button>
            {% endfor %}

            <!-- Save new config -->
            <details class="group/save relative ml-auto">
              <summary class="list-none cursor-pointer [&::-webkit-details-marker]:hidden inline-flex items-center gap-1 rounded-full border px-2.5 py-0.5 text-xs font-medium transition-colors bg-slate-200 text-slate-700 border-slate-400 hover:bg-slate-300 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-600 dark:hover:bg-slate-700">
                <i class="bx bx-bookmark-plus text-sm"></i>
                Save configuration
              </summary>
              <div class="absolute right-0 z-10 mt-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg shadow-lg p-3">
                <form method="POST" action="/{{ org }}/saved-configurations" class="flex items-center gap-2">
                  {% for key in configurationQueryKeys %}<input type="hidden" name="{{ key }}" />{% endfor %}
                  <input type="text" name="name" placeholder="Name (optional)"
                    class="rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-slate-400 w-44"
                  />
                  <button type="submit" class="inline-flex items-center gap-1 rounded-full border px-2.5 py-1 text-xs font-medium transition-colors bg-slate-700 text-white border-slate-700 hover:bg-slate-600 dark:bg-slate-200 dark:text-slate-900 dark:border-slate-200 dark:hover:bg-slate-300">
                    <i class="bx bx-save"></i>
                    Save
                  </button>
                </form>
              </div>
            </details>
          </div>


          <!-- Saved configurations row. The grid script marks the configuration matching the current filters. -->
          {% if savedConfigurations and savedConfigurations.length %}
          <div class="p-2 flex flex-wrap items-center gap-2">
            {% for config in savedConfigurations %}
            <div class="flex items-center">
              <a href="{{ config.applyUrl | safe }}" data-saved-configuration aria-current="false" class="inline-flex items-center gap-1 rounded-l-full border px-2.5 py-0.5 text-xs font-medium transition-colors bg-slate-200 text-slate-700 border-slate-400 hover:bg-slate-300 dark:bg-slate-700 dark:text-slate-200 dark:border-slate-600 dark:hover:bg-slate-600 aria-[current=true]:bg-slate-700 aria-[current=true]:text-white aria-[current=true]:border-slate-700 dark:aria-[current=true]:bg-slate-200 dark:aria-[current=true]:text-slate-900 dark:aria-[current=true]:border-slate-200">
                <i class="bx bx-bookmark text-xs"></i>
                {{ config.name }}
              </a>
              <form method="POST" action="/{{ org }}/saved-configurations/{{ config.id }}/delete" class="inline">
                {% for key in configurationQueryKeys %}<input type="hidden" name="{{ key }}" />{% endfor %}
                <button type="submit" title="Delete" class="inline-flex items-center rounded-r-full border-t border-r border-b px-1.5 py-0.5 text-xs transition-colors bg-slate-200 text-slate-400 border-slate-400 hover:bg-red-100 hover:text-red-600 hover:border-red-400 dark:bg-slate-700 dark:text-slate-500 dark:border-slate-600 dark:hover:bg-red-950 dark:hover:text-red-400 dark:hover:border-red-800">
                  <i class="bx bx-x text-sm"></i>
                </button>
              </form>
            </div>
            {% endfor %}

            <a href="/{{ org }}" data-clear-configuration hidden class="inline-flex [&[hidden]]:hidden items-center gap-1 rounded-full border px-2.5 py-0.5 text-xs font-medium transition-colors bg-slate-200 text-slate-700 border-slate-400 hover:bg-slate-300 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-600 dark:hover:bg-slate-700">
              <i class="bx bx-reset text-xs"></i>
              Clear
            </a>
          </div>
          {% endif %}


        </div>

        <!-- Repo table -->
        <div id="repo-table" class="mx-4 mb-4">
          <div id="repo-grid" class="w-full" style="height: 75vh" data-testid="repo-grid"
            data-configuration-query-keys="{{ configurationQueryKeys | join(',') }}"></div>
          <script type="application/json" id="repo-grid-data">{{ gridRows | safe }}</script>
        </div>

      </div>
    </div>
{% endblock %}

{% block scripts %}
    <script src="https://cdn.jsdelivr.net/npm/ag-grid-community@36.2.0/dist/ag-grid-community.min.js"
      integrity="sha384-icvtRKM0YJJgeDhXnWY8UlF1PVBFd4K8Pj61la+vG+EU+awBeoP0xGPZhCD2SQOV"
      crossorigin="anonymous"></script>
    <script>
      (() => {
        const DASH = '\u2014';
        const gridElement = document.getElementById('repo-grid');
        const rowData = JSON.parse(document.getElementById('repo-grid-data').textContent);
        const configurationQueryKeys = gridElement.dataset.configurationQueryKeys.split(',');

        // GitHub topics must start with a letter or number, so this can never clash with a real tag.
        const UNTAGGED = '_untagged';
        const splitTags = (value) => (value ? value.split(', ') : []);
        const hasAnyTag = (tags, candidates) => candidates.some((tag) => tags.includes(tag));

        const MODES = {
          'd-plus': { name: 'D+', test: (tags) => hasAnyTag(tags, ['d-plus', 'delivery-plus', 'internal']) && !tags.includes('govpress') },
          publishing: { name: 'Publishing', test: (tags) => tags.includes('govpress') },
          ops: { name: 'Ops', test: (tags) => hasAnyTag(tags, ['dalmatian', 'tech-ops']) },
        };

        const ALERT_FILTER_COLUMNS = { criticalOnly: 'runtimeCritical', anyAlerts: 'runtimeTotal' };
        const HAS_ALERTS = { filterType: 'number', type: 'greaterThan', filter: 0 };
        const isHasAlerts = (model) => model?.type === HAS_ALERTS.type && model.filter === HAS_ALERTS.filter;

        const tagsFilterOptions = [
          { displayKey: 'hasTag', displayName: 'Has tag', predicate: ([tag], value) => splitTags(value).includes(tag) },
          ...Object.entries(MODES).map(([mode, { name, test }]) => ({
            displayKey: mode,
            displayName: `${name} repos`,
            numberOfInputs: 0,
            predicate: (_, value) => test(splitTags(value)),
          })),
          'contains', 'notContains', 'equals', 'notEqual', 'startsWith', 'endsWith', 'blank', 'notBlank',
        ];

        // The filter buttons and tag chips each add a condition to the tags column filter, combined with OR.
        const tagsFilterModel = ({ tags, mode }) => {
          const conditions = [
            ...(mode in MODES ? [{ filterType: 'text', type: mode }] : []),
            ...tags.map((tag) => (tag === UNTAGGED
              ? { filterType: 'text', type: 'blank' }
              : { filterType: 'text', type: 'hasTag', filter: tag })),
          ];
          if (conditions.length <= 1) return conditions[0] ?? null;
          return { filterType: 'text', operator: 'OR', conditions };
        };

        const filterModelFromUrl = () => {
          try {
            return JSON.parse(new URL(window.location.href).searchParams.get('filter')) ?? {};
          } catch {
            return {};
          }
        };

        let grid;
        let currentFilters = { tags: [] };

        const readFilters = () => {
          const tagsModel = grid.getColumnFilterModel('tags');
          const conditions = tagsModel ? tagsModel.conditions ?? [tagsModel] : [];
          return {
            alertFilter: Object.keys(ALERT_FILTER_COLUMNS).find((key) => isHasAlerts(grid.getColumnFilterModel(ALERT_FILTER_COLUMNS[key]))),
            tags: conditions.flatMap(({ type, filter }) => {
              if (type === 'blank') return [UNTAGGED];
              return type === 'hasTag' ? [filter] : [];
            }),
            mode: conditions.find(({ type }) => type in MODES)?.type,
          };
        };

        const toggleAlertFilter = async (alertFilter) => {
          const current = currentFilters.alertFilter;
          if (current) await grid.setColumnFilterModel(ALERT_FILTER_COLUMNS[current], null);
          if (current !== alertFilter) await grid.setColumnFilterModel(ALERT_FILTER_COLUMNS[alertFilter], HAS_ALERTS);
          grid.onFilterChanged();
        };

        const setTagsFilter = async (filters) => {
          await grid.setColumnFilterModel('tags', tagsFilterModel(filters));
          grid.onFilterChanged();
        };

        // Tags and modes are mutually exclusive, so choosing one clears the other
        const toggleTag = (tag) => {
          const { tags } = currentFilters;
          setTagsFilter({ tags: tags.includes(tag) ? tags.filter((selected) => selected !== tag) : [...tags, tag] });
        };

        const toggleMode = (mode) => setTagsFilter({ tags: [], mode: currentFilters.mode === mode ? null : mode });

        const queryFor = (url) => {
          const params = new URL(url, window.location.href).searchParams;
          return configurationQueryKeys.map((key) => params.get(key) ?? '').join('&');
        };

        // Reflects the grid's filters in the filter buttons, the URL, and the saved configuration forms and links
        const syncFilters = () => {
          currentFilters = readFilters();
          const { alertFilter, tags, mode } = currentFilters;

          for (const button of document.querySelectorAll('[data-alert-filter]')) button.ariaPressed = String(button.dataset.alertFilter === alertFilter);
          for (const button of document.querySelectorAll('[data-mode]')) button.ariaPressed = String(button.dataset.mode === mode);
          for (const button of document.querySelectorAll('[data-tag]')) button.ariaPressed = String(tags.includes(button.dataset.tag));

          const url = new URL(window.location.href);
          const filterModel = grid.getFilterModel();
          if (Object.keys(filterModel).length) url.searchParams.set('filter', JSON.stringify(filterModel));
          else url.searchParams.delete('filter');
          window.history.replaceState(null, '', url);

          for (const input of document.querySelectorAll('form input[type=hidden]')) {
            input.value = url.searchParams.get(input.name) ?? '';
          }

          const savedConfigurationLinks = [...document.querySelectorAll('[data-saved-configuration]')];
          for (const link of savedConfigurationLinks) link.ariaCurrent = String(queryFor(link.href) === queryFor(url));
          const clearLink = document.querySelector('[data-clear-configuration]');
          if (clearLink) clearLink.hidden = !savedConfigurationLinks.some((link) => link.ariaCurrent === 'true');
        };

        document.addEventListener('click', (event) => {
          const button = event.target.closest('[data-alert-filter], [data-mode], [data-tag]');
          if (!button) return;
          if (button.dataset.alertFilter) toggleAlertFilter(button.dataset.alertFilter);
          else if (button.dataset.mode) toggleMode(button.dataset.mode);
          else toggleTag(button.dataset.tag);
        });

        const compareDateToFilter = (filterDate, cellValue) => {
          if (!cellValue) return -1;
          const date = new Date(cellValue);
          const cellDay = new Date(date.getFullYear(), date.getMonth(), date.getDate());
          if (cellDay < filterDate) return -1;
          if (cellDay > filterDate) return 1;
          return 0;
        };

        // Dates are sorted/filtered on their ISO value but displayed in the user's chosen format.
        const dateColumn = (field, headerName) => ({
          colId: field,
          headerName,
          cellDataType: false,
          type: 'rightAligned',
          valueGetter: (params) => params.data[field].iso,
          valueFormatter: (params) => params.data[field].display ?? DASH,
          filter: 'agDateColumnFilter',
          filterParams: { comparator: compareDateToFilter },
          width: 130,
        });

        const numberColumn = (field, headerName, extra = {}) => ({
          field,
          headerName,
          cellDataType: 'number',
          type: 'rightAligned',
          filter: 'agNumberColumnFilter',
          valueFormatter: (params) => params.value ?? DASH,
          width: 105,
          ...extra,
        });

        const severityColumn = (field, headerName, color) =>
          numberColumn(field, headerName, {
            cellStyle: (params) => (params.value > 0 ? { color, fontWeight: '700' } : null),
          });

        const vulnerabilityGroup = (prefix, headerName) => ({
          headerName,
          marryChildren: true,
          children: [
            severityColumn(`${prefix}Critical`, 'Critical', '#dc2626'),
            severityColumn(`${prefix}High`, 'High', '#ef4444'),
            severityColumn(`${prefix}Medium`, 'Medium', '#f97316'),
            severityColumn(`${prefix}Low`, 'Low', '#f59e0b'),
            numberColumn(`${prefix}Total`, 'Total', { cellStyle: { fontWeight: '600' } }),
          ],
        });

        const repoLinkRenderer = (params) => {
          const link = document.createElement('a');
          link.href = params.data.htmlUrl;
          link.target = '_blank';
          link.rel = 'noopener';
          link.textContent = params.value;
          link.className = 'font-semibold hover:underline';
          return link;
        };

        const tagsRenderer = (params) => {
          const container = document.createElement('div');
          container.className = 'flex gap-1 items-center h-full overflow-hidden';
          for (const tag of params.data.tags) {
            const chip = document.createElement('button');
            chip.type = 'button';
            chip.dataset.tag = tag;
            chip.ariaPressed = String(currentFilters.tags.includes(tag));
            chip.className = 'text-xs rounded-full px-2 leading-5 transition-colors bg-slate-200 text-slate-700 hover:bg-slate-300 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 '
              + 'aria-pressed:text-white aria-pressed:bg-slate-700 dark:aria-pressed:text-slate-900 dark:aria-pressed:bg-slate-200';
            chip.textContent = tag;
            container.appendChild(chip);
          }
          return container;
        };

        const describeEndOfLife = (dependency) => {
          const label = dependency.version ? `${dependency.name} v${dependency.version}` : dependency.name;
          const support = dependency.status === 'ended' ? 'support ended' : 'support ends';
          return dependency.relative ? `${label}: ${support} ${dependency.relative}` : `${label}: ${support}`;
        };

        // Ranks repos by how many dependencies are out of support, then by how many are ending soon
        const endOfLifeScore = (dependencies) => dependencies.reduce(
          (score, dependency) => score + (dependency.status === 'ended' ? 1000 : 1),
          0,
        );

        const endOfLifeRenderer = (params) => {
          const container = document.createElement('div');
          container.className = 'flex gap-1 items-center h-full overflow-hidden';
          for (const dependency of params.data.endOfLifeDependencies) {
            const chip = document.createElement('span');
            chip.className = 'font-mono text-xs rounded-full px-2 leading-5 whitespace-nowrap text-white ' +
              (dependency.status === 'ended' ? 'bg-red-600 dark:bg-red-500' : 'bg-amber-500 dark:bg-amber-600');
            chip.textContent = dependency.version ? `${dependency.name} v${dependency.version}` : dependency.name;
            chip.title = describeEndOfLife(dependency);
            container.appendChild(chip);
          }
          if (!params.data.endOfLifeDependencies.length) container.textContent = DASH;
          return container;
        };

        const columnDefs = [
          { field: 'name', headerName: 'Repo', pinned: 'left', width: 220, cellRenderer: repoLinkRenderer },
          {
            field: 'description',
            headerName: 'Description',
            width: 300,
            valueFormatter: (params) => params.value ?? DASH,
            tooltipValueGetter: (params) => params.value || null,
          },
          { field: 'language', headerName: 'Language', width: 120, valueFormatter: (params) => params.value ?? DASH },
          numberColumn('openPrCount', 'Open PRs'),
          numberColumn('openBotPrCount', 'Open bot PRs'),
          dateColumn('oldestOpenPrOpenedAt', 'Oldest open PR'),
          dateColumn('updatedAt', 'Updated at'),
          dateColumn('mostRecentNonBotCommitAt', 'Most recent non-bot commit'),
          dateColumn('mostRecentPrOpenedAt', 'Most recent PR'),
          dateColumn('mostRecentIssueOpenedAt', 'Most recent issue'),
          dateColumn('oldestOpenIssueOpenedAt', 'Oldest open issue'),
          numberColumn('openIssues', 'Open issues'),
          vulnerabilityGroup('runtime', 'Runtime vulnerabilities'),
          vulnerabilityGroup('dev', 'Dev vulnerabilities'),
          {
            colId: 'endOfLifeDependencies',
            headerName: 'End of life',
            headerTooltip: 'Dependencies that are out of support or whose support ends within a year',
            width: 260,
            cellDataType: false,
            valueGetter: (params) => params.data.endOfLifeDependencies.map(describeEndOfLife).join('; '),
            tooltipValueGetter: (params) => params.value || null,
            comparator: (valueA, valueB, nodeA, nodeB) =>
              endOfLifeScore(nodeA.data.endOfLifeDependencies) - endOfLifeScore(nodeB.data.endOfLifeDependencies),
            cellRenderer: endOfLifeRenderer,
          },
          {
            colId: 'tags',
            headerName: 'Tags',
            width: 260,
            valueGetter: (params) => params.data.tags.join(', '),
            tooltipValueGetter: (params) => params.value || null,
            filter: 'agTextColumnFilter',
            filterParams: { filterOptions: tagsFilterOptions, maxNumConditions: 50 },
            cellRenderer: tagsRenderer,
          },
          { field: 'responsibleTeam', headerName: 'Responsible team', width: 150, valueFormatter: (params) => params.value ?? DASH },
          {
            colId: 'hasRuntimeAlertOlderThan14Days',
            headerName: 'Runtime vulnerability > 14 days old',
            headerTooltip: 'Has an open runtime vulnerability more than 14 days old',
            width: 150,
            cellDataType: false,
            valueGetter: (params) => {
              const value = params.data.hasRuntimeAlertOlderThan14Days;
              if (value === null) return null;
              return value ? 'Yes' : 'No';
            },
            valueFormatter: (params) => params.value ?? DASH,
            cellStyle: (params) => (params.value === 'Yes' ? { color: '#dc2626', fontWeight: '700' } : null),
          },
        ];

        const theme = agGrid.themeQuartz
          .withParams({ fontFamily: 'inherit', fontSize: 13, headerFontWeight: 600, wrapperBorderRadius: 8 })
          .withParams({ accentColor: '#475569', browserColorScheme: 'light' }, 'light')
          .withParams({
            backgroundColor: '#1e293b',
            foregroundColor: '#e2e8f0',
            headerBackgroundColor: '#0f172a',
            borderColor: '#334155',
            accentColor: '#94a3b8',
            browserColorScheme: 'dark',
          }, 'dark');

        grid = agGrid.createGrid(gridElement, {
          theme,
          rowData,
          columnDefs,
          initialState: { filter: { filterModel: filterModelFromUrl() } },
          onFilterChanged: syncFilters,
          defaultColDef: { sortable: true, filter: true, resizable: true, wrapHeaderText: true, autoHeaderHeight: true },
          pagination: true,
          paginationPageSize: 50,
          paginationPageSizeSelector: [25, 50, 100],
          suppressColumnVirtualisation: true,
          overlayNoRowsTemplate: '<span class="italic text-slate-400">No repositories found.</span>',
        });
        syncFilters();
      })();
    </script>
{% endblock %}
