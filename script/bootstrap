#!/bin/bash

# script/bootstrap: Resolve all dependencies that the application requires to
#                   run.

set -e

cd "$(dirname "$0")/.."


if command -v nvm 2>&1; then
    export NVM_DIR=$HOME/.nvm;
    source $NVM_DIR/nvm.sh;

    echo "==> Installing node version using nvm..."
    nvm install
elif command -v nodenv 2>&1; then
    echo "==> Installing node version using nodenv..."
    nodenv install --skip-existing
elif command -v asdf 2>&1; then
    echo "==> Installing node version using asdf..."
    asdf install nodejs
else
    echo "ERROR: nvm, nodenv, or asdf not found"
    exit 1
fi


echo "==> Installing node modules..."
npm install

if [ "$1" = "--seed" ]; then
    echo "==> Seeding data..."
    npm run seed
else
    echo "==> Skipping seeding data..."
fi
